[Unit]
Description=TG Persona - Telegram 人形分身监听
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-persona
ExecStart=/opt/tg-persona/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8090 --no-proxy-headers
Restart=always
RestartSec=5
# 首次密码用 data/panel_password.txt(600)预置，启动后转为哈希并删除。
# 不要把密码写进任何 0644 的 systemd unit。
# nginx 反代时可按实际地址设置可信代理：
# Environment=TRUSTED_PROXIES=127.0.0.1,::1

[Install]
WantedBy=multi-user.target
